# Copy to .env.local for local development. On Netlify, add these under
# Site configuration > Environment variables. Never commit real values.

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only: used to look up a student's email at login and to sync members.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Any long random string; the Google Apps Script sends it with each member sync.
MEMBERS_SYNC_SECRET=change-me-to-a-long-random-string
